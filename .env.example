# Copy this file to .env and fill in your real values.
# Never commit .env to git — only commit .env.example

# Secret key your Windows installer app sends in X-API-Key header
API_KEY=change-this-to-a-long-random-string

# Secret key your key generator app sends in X-Admin-Key header
ADMIN_KEY=change-this-to-a-different-long-random-string

# Path to the SQLite database file
DB_PATH=/data/licenses.db
